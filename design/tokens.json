{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "OPENCREW Labs design tokens v1.1. Anchored on the official logo gold #C19C68; all other hues are golden-angle (137.508deg) rotations from it in OKLCH. Spacing/type/layout ratios derived from phi (1.6180339887).",
  "meta": {
    "version": "1.1.0",
    "phi": 1.6180339887,
    "goldenAngle": 137.50776405,
    "hueAnchor": 75.29,
    "hueAnchorSource": "Official logo gold #C19C68 = oklch(71.48% 0.0817 75.29). Measured from logo/*.svg, not chosen.",
    "hueDerivation": {
      "gold": "H0 = 75.29 (official logo gold, gold-500 is exact)",
      "verdant": "H0 + goldenAngle/2 = 144.04",
      "azure": "H0 + goldenAngle = 212.80",
      "rose": "H0 + goldenAngle*2 = 350.31 (RESERVED, unused)",
      "red": "25 (PINNED for legibility, not derived)",
      "ink": "250 (pinned cool cast)"
    }
  },

  "color": {
    "ink": {
      "1000": { "$value": "#020305", "oklch": "9.5% 0.010 250" },
      "950":  { "$value": "#080D12", "oklch": "15.5% 0.013 250" },
      "900":  { "$value": "#10161C", "oklch": "19.6% 0.015 250" },
      "850":  { "$value": "#191F26", "oklch": "23.8% 0.015 250" },
      "800":  { "$value": "#242A31", "oklch": "28.2% 0.015 250" },
      "700":  { "$value": "#363D43", "oklch": "35.5% 0.014 250" },
      "600":  { "$value": "#50555B", "oklch": "44.8% 0.012 250" },
      "500":  { "$value": "#6D7378", "oklch": "55.2% 0.011 250" },
      "400":  { "$value": "#8C9197", "oklch": "65.5% 0.010 250" },
      "300":  { "$value": "#ABAFB3", "oklch": "75.2% 0.008 250" },
      "200":  { "$value": "#CACDD1", "oklch": "84.8% 0.006 250" },
      "100":  { "$value": "#E2E4E6", "oklch": "91.8% 0.004 250" },
      "50":   { "$value": "#F1F3F5", "oklch": "96.3% 0.003 250" },
      "0":    { "$value": "#FFFFFF", "oklch": "100% 0 250" }
    },
    "gold": {
      "$description": "Bullion. H 75.29 — the anchor. gold-500 IS the official logo gold.",
      "50":  { "$value": "#FCF2E5" }, "100": { "$value": "#F6E5CE" },
      "200": { "$value": "#EFD4B1" }, "300": { "$value": "#E0BF92" },
      "400": { "$value": "#D1AD7B" }, "500": { "$value": "#C19C68", "oklch": "71.48% 0.0817 75.29", "official": true },
      "600": { "$value": "#A88655" }, "700": { "$value": "#886A40" },
      "800": { "$value": "#67502E" }, "900": { "$value": "#45341C" },
      "950": { "$value": "#271D0D" }
    },
    "azure": {
      "$description": "Meridian. H 212.80 = anchor + golden angle.",
      "50":  { "$value": "#EBF5F8" }, "100": { "$value": "#D6ECF1" },
      "200": { "$value": "#BADEE7" }, "300": { "$value": "#96CCD8" },
      "400": { "$value": "#76B8C6" }, "500": { "$value": "#58A1B0" },
      "600": { "$value": "#3F8997" }, "700": { "$value": "#2A6E7B" },
      "800": { "$value": "#1C525C" }, "900": { "$value": "#11383F" },
      "950": { "$value": "#072025" }
    },
    "verdant": {
      "$description": "Verdant. H 144.04 = anchor + half golden angle.",
      "50":  { "$value": "#EDF6EC" }, "100": { "$value": "#DBEDDA" },
      "200": { "$value": "#C2E1C0" }, "300": { "$value": "#A5D1A4" },
      "400": { "$value": "#8BC089" }, "500": { "$value": "#77AF76" },
      "600": { "$value": "#619460" }, "700": { "$value": "#4B754B" },
      "800": { "$value": "#375736" }, "900": { "$value": "#243A24" },
      "950": { "$value": "#122112" }
    },
    "red": {
      "$description": "Alert. H 25 — pinned, not derived.",
      "50":  { "$value": "#FEEFEE" }, "100": { "$value": "#FCE0DD" },
      "200": { "$value": "#FAC8C3" }, "300": { "$value": "#F9A7A0" },
      "400": { "$value": "#F28079" }, "500": { "$value": "#E35451" },
      "600": { "$value": "#C73D3C" }, "700": { "$value": "#A22C2D" },
      "800": { "$value": "#7B2020" }, "900": { "$value": "#561615" },
      "950": { "$value": "#340B0B" }
    }
  },

  "semantic": {
    "dark": {
      "canvas": "{color.ink.950}", "canvasSunken": "{color.ink.1000}",
      "surface": "{color.ink.900}", "surfaceRaised": "{color.ink.850}",
      "border": "{color.ink.800}", "borderStrong": "{color.ink.700}",
      "text": "{color.ink.0}", "textSecondary": "{color.ink.300}",
      "textMuted": "{color.ink.400}", "textDisabled": "{color.ink.600}",
      "accent": "{color.gold.500}", "accentHover": "{color.gold.400}",
      "accentActive": "{color.gold.600}", "accentText": "{color.gold.400}",
      "accentSubtle": "{color.gold.950}", "onAccent": "{color.ink.1000}",
      "link": "{color.azure.300}", "focus": "{color.azure.400}",
      "success": "{color.verdant.400}", "danger": "{color.red.400}",
      "warning": "{color.gold.400}"
    },
    "light": {
      "canvas": "{color.ink.0}", "canvasSunken": "{color.ink.50}",
      "surface": "{color.ink.0}", "surfaceRaised": "{color.ink.0}",
      "border": "{color.ink.100}", "borderStrong": "{color.ink.200}",
      "text": "{color.ink.1000}", "textSecondary": "{color.ink.700}",
      "textMuted": "{color.ink.600}", "textDisabled": "{color.ink.400}",
      "accent": "{color.gold.500}", "accentHover": "{color.gold.400}",
      "accentActive": "{color.gold.600}", "accentText": "{color.gold.800}",
      "accentSubtle": "{color.gold.50}", "onAccent": "{color.ink.1000}",
      "link": "{color.azure.800}", "focus": "{color.azure.700}",
      "success": "{color.verdant.700}", "danger": "{color.red.700}",
      "warning": "{color.gold.800}"
    }
  },

  "contrast": {
    "$description": "Verified WCAG 2.1 ratios. All listed pairs pass AA.",
    "dark": {
      "text/canvas": 19.54, "textSecondary/canvas": 8.85, "textMuted/canvas": 6.17,
      "accent/canvas": 7.65, "link/canvas": 11.1, "success/canvas": 9.29, "danger/canvas": 7.58,
      "onAccent/accent": 8.08
    },
    "light": {
      "text/canvas": 20.64, "textSecondary/canvas": 11.07, "textMuted/canvas": 7.49,
      "accentText/canvas": 7.63, "link/canvas": 8.70, "success/canvas": 5.32, "danger/canvas": 7.14,
      "onAccent/accent": 8.08
    }
  },

  "typography": {
    "family": {
      "sans":  { "$value": "Geist Sans", "fallback": ["Noto Sans SC", "ui-sans-serif", "system-ui"] },
      "serif": { "$value": "Instrument Serif", "fallback": ["Noto Serif SC", "ui-serif", "Georgia"] },
      "mono":  { "$value": "Geist Mono", "fallback": ["ui-monospace", "SF Mono", "Menlo"] }
    },
    "scale": {
      "$description": "Modular scale, ratio sqrt(phi) = 1.272, base 16px",
      "2xs":  { "size": 11,  "leading": 16,  "tracking": "0.08em" },
      "xs":   { "size": 12,  "leading": 18,  "tracking": "0.06em" },
      "sm":   { "size": 14,  "leading": 22,  "tracking": "0" },
      "base": { "size": 16,  "leading": 26,  "tracking": "0" },
      "lg":   { "size": 20,  "leading": 32,  "tracking": "-0.005em" },
      "xl":   { "size": 26,  "leading": 34,  "tracking": "-0.01em" },
      "2xl":  { "size": 33,  "leading": 40,  "tracking": "-0.015em" },
      "3xl":  { "size": 42,  "leading": 48,  "tracking": "-0.02em" },
      "4xl":  { "size": 53,  "leading": 58,  "tracking": "-0.025em" },
      "5xl":  { "size": 68,  "leading": 72,  "tracking": "-0.03em" },
      "6xl":  { "size": 86,  "leading": 88,  "tracking": "-0.032em" },
      "7xl":  { "size": 110, "leading": 108, "tracking": "-0.035em" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "measure": { "prose": "68ch", "lead": "56ch" }
  },

  "space": {
    "$description": "phi scale from 4px",
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 10, "5": 16,
    "6": 26, "7": 42, "8": 68, "9": 110, "10": 178
  },

  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 16, "xl": 26, "full": 9999 },

  "layout": {
    "containerMax": 1320,
    "containerContent": 1064,
    "headerHeight": 64,
    "goldenSplit": "1.618fr 1fr",
    "breakpoints": { "sm": 480, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
    "grid": {
      "sm": { "columns": 4,  "gutter": 16, "margin": 20 },
      "md": { "columns": 8,  "gutter": 26, "margin": 32 },
      "lg": { "columns": 12, "gutter": 26, "margin": 42 },
      "xl": { "columns": 12, "gutter": 26, "margin": 68 }
    }
  },

  "motion": {
    "duration": {
      "instant": 100, "fast": 140, "base": 180,
      "slow": 220, "drawer": 300, "reveal": 460
    },
    "easing": {
      "out":    "cubic-bezier(0.23, 1, 0.32, 1)",
      "inOut":  "cubic-bezier(0.77, 0, 0.175, 1)",
      "drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
      "hover":  "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "spring": { "tray": { "type": "spring", "duration": 0.5, "bounce": 0.15 } },
    "stagger": 40,
    "pressScale": 0.97,
    "enterScale": 0.97
  },

  "elevation": {
    "0": { "dark": "none", "light": "none" },
    "1": { "dark": "1px border", "light": "1px border, 0 1px 2px rgb(2 3 5 / .04)" },
    "2": { "dark": "0 8px 24px -8px rgb(0 0 0 / .5)", "light": "0 8px 24px -8px rgb(2 3 5 / .12)" },
    "3": { "dark": "0 24px 64px -16px rgb(0 0 0 / .6)", "light": "0 24px 64px -16px rgb(2 3 5 / .18)" }
  },

  "zIndex": {
    "base": 0, "sticky": 100, "header": 200,
    "tray": 300, "overlay": 400, "modal": 500, "toast": 600
  }
}
