# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
*.tsbuildinfo

# testing
/coverage

# environment — only .env.example is tracked
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Internal material — this repo is PUBLIC.
#
# The pitch deck, the founding brief and the docs/ set (brand identity, copy
# deck) are internal business material, and docs/ additionally contains claims
# still pending verification. They stay local. If this repo is ever made
# private, these can be un-ignored — but they must never land in public history,
# because deleting a file later does not remove it from git.
# ---------------------------------------------------------------------------
/OPENCREW V3.pdf
/opencrew.md
/docs/

# Claude Code local state — machine-specific paths and permissions.
.claude/settings.local.json
.agents/

# Raw showcase photography — source only. The site serves the optimised
# derivatives in public/showcase/web/; the 4–8 MB originals stay local.
/public/showcase/*.jpg
/public/showcase/*.JPG
/public/showcase/*.jpeg
/public/showcase/*.png

# One-off local tooling (partner-logo fetch scripts carry a hard-coded Brandfetch API key)
/scripts/

# Applicant intake file: names, photos, nationality and contact details of real
# people. The site publishes what they agreed to publish; the raw file is not it.
/crews.docx
