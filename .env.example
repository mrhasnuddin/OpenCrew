# ---------------------------------------------------------------------------
# OPENCREW Labs — environment
# Copy to .env.local for development; set the same keys in the Vercel project.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, sitemap.xml, robots.txt and OG image
# URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://opencrew.example

# ---------------------------------------------------------------------------
# Brief + application submission (app/api/brief/route.ts)
#
# All three must be set for direct sending to activate. With any of them
# missing, the endpoint returns 501 and both forms fall back to
# compose-and-copy — never a false success screen.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
BRIEF_TO_EMAIL=
# Must be a verified sender on your Resend domain.
BRIEF_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional). When set, gtag loads on every page.
# ⚠️ GA sets cookies — update /legal/privacy before enabling in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
